<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>ProRoaster Updates</title>
    <item>
      <title>Versão 1.0.1</title>
      <sparkle:releaseNotesLink>
        <!-- Opcional: Link para notas da versão (pode ser a própria release) -->
        https://github.com/gustavopradof/ProRoasterUpdates/releases/tag/v1.0.1
      </sparkle:releaseNotesLink>
      <pubDate>Sun, 17 Nov 2025 10:00:00 +0000</pubDate>
      
      <!-- 
        Este é o bloco principal.
        Ele aponta para o ARQUIVO DE INSTALAÇÃO (não para o appcast.xml)
        e diz qual é a versão.
      -->
      <enclosure
          <!-- 
            IMPORTANTE: A URL aqui deve ser a do ARQUIVO DE DOWNLOAD DA TAG ESPECÍFICA (v1.0.1),
            NÃO a URL 'latest' que você usou no seu app.
            
            MUDANÇA 1: Alterado de .exe para .deb
          -->
          url="https://github.com/gustavopradof/ProRoasterUpdates/releases/download/v1.0.1/ProRoaster-1.0.1.deb"
          
          <!-- Esta versão deve ser MAIOR que a versão atual do seu app -->
          sparkle:version="1.0.1"
          
          <!-- O 'length' é o tamanho do arquivo em bytes. O updater pode funcionar sem, mas é bom ter -->
          length="12345678" 
          type="application/octet-stream"
          
          <!-- MUDANÇA 2: Especifique o S.O. (linux) -->
          sparkle:os="linux"
      />
    </item>
    
    <!-- Você pode adicionar mais <item> para versões mais antigas se quiser -->
    
  </channel>
